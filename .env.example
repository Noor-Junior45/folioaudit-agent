# PostgreSQL connection string with WRITE access.
# In Supabase: Project Settings -> Database -> Connection string -> URI
# Use either direct (port 5432) or connection pooler (port 6543 / 5432).
SUPABASE_DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# LLM fallback parser — needed only when the deterministic parser fails.
# The app tries GEMINI_API_KEY first, then ANTHROPIC_API_KEY.
# You only need ONE of these two.

# Option 1 (Recommended — FREE tier available):
# Get a free key at https://ai.google.dev
GEMINI_API_KEY=AIza...

# Option 2 (Alternative):
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
